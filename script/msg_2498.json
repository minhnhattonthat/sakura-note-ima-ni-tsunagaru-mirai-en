  "status": "todo",
  "notes": ""
 },
 {
  "id": "2498:15",
  "hdr": "000B 0011",
  "jp": "というわけで、おれ、帰る。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2498:16",
  "hdr": "000A 0013",
  "jp": "明日、{var_EF}{slot}{slot}{slot}{slot}{slot}ンちいくぞ。{n}新しいゲームあるんだろ？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2498:17",
  "hdr": "000B 0011",
