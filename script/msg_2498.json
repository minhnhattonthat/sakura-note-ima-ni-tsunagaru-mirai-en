  "status": "todo",
  "notes": ""
 },
 {
  "id": "2498:20",
  "hdr": "000A 0013",
  "jp": "じゃあな、{var_EF}{slot}{slot}{slot}{slot}{slot}。{n}また明日！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2498:21",
  "hdr": "000A 0013",
  "jp": "制服着た女子、見た？{n}私立からの転校生だよな。",
