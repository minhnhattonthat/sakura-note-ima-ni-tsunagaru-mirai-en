[
 {
  "id": "2498:0",
  "hdr": "FFFF 00FF",
  "jp": "人は誰でも{n}ヒーロー、ヒロインに{n}なることができる。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2498:1",
  "hdr": "FFFF 00FF",
  "jp": "でも、なりたいと思って{n}なれるものではない。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2498:2",
  "hdr": "FFFF 00FF",
  "jp": "誰かにヒーローだと認めてもらい……{n}誰かにヒロインだと認めてもらい……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2498:3",
  "hdr": "FFFF 00FF",
  "jp": "つまり、他の誰かに{n}認めてもらうことが重要だ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2498:4",
  "hdr": "FFFF 00FF",
  "jp": "誰かがそう思ってくれるなら{n}本人の自覚なんて{n}必要ないのかもしれない。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2498:5",
  "hdr": "FFFF 00FF",
  "jp": "……本当の主人公は{n}ヒーロー、ヒロインのまわりにいる{n}あの人や、その人なのかも……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2498:6",
  "hdr": "0006 0014",
  "jp": "{var_EF}{slot}{slot}{slot}{slot}{slot}！{n}いい加減に起きなさい！　遅刻よ！",
