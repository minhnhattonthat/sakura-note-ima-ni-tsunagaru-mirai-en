[
 {
  "id": "2500:0",
  "hdr": "000D 0010",
  "jp": "いやー、失敗、失敗。{n}これじゃおれは誘拐犯じゃないか。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:1",
  "hdr": "000D 0010",
  "jp": "ちがうから、絶対ちがうから！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:2",
  "hdr": "000D 0010",
  "jp": "さて、どうするんだっけ？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:3",
  "hdr": "000D 0010",
  "jp": "そうそう、ヒーローを見つけるんだ。{n}七海を助ける我らがヒーロー……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:4",
  "hdr": "000D 0010",
  "jp": "それにしても、いそがしいなあ、もう。{n}おれはウサギかよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:5",
  "hdr": "000D 0010",
  "jp": "……おれが見えてるのかい？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:6",
  "hdr": "000D 0010",
  "jp": "七海と同じニオイがする！{n}どういうことだ？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:7",
  "hdr": "000D 0010",
  "jp": "いやー、どうでもいいや。{n}これも何かの縁ってやつだ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:8",
  "hdr": "000D 0010",
  "jp": "と、とにかく来てくれ！{n}さあ、神社の中へ！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:9",
  "hdr": "0017 000D",
  "jp": "わん？　わわわん、わわわん！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:10",
  "hdr": "0004 000D",
  "jp": "わん？　わわわん、わわわん！{n}{col_F8}(えっ？　七海さんのニオイ！？)",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:11",
  "hdr": "0017 000D",
  "jp": "わんわんわんわん！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:12",
  "hdr": "0004 000D",
  "jp": "わんわんわんわん！{n}{col_F8}(助けてください！)",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:13",
  "hdr": "FFFF 00FF",
  "jp": "変なおじさん……なれなれしい犬……{n}少年の心の中では{n}戸惑い、恐怖心、好奇心が{n}手を取り合って踊っていた。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:14",
  "hdr": "00FF 000C",
  "jp": "変なおじさんに、知らない犬……{n}いったい何なんだろう。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:15",
  "hdr": "000D 0010",
  "jp": "なんか様子が変だよな……{n}桜のせいかな、それとも妖怪？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:16",
  "hdr": "0004 000D",
  "jp": "おじさんのせいじゃないですか！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:17",
  "hdr": "000D 0010",
  "jp": "しっ！　鳥に見つかる！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:18",
  "hdr": "000D 0010",
  "jp": "怖がることはない。{n}おれははっきり言って紳士だ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:19",
  "hdr": "000D 0010",
  "jp": "少年、おまえさんは自分がヒーローだと{n}思ったことはあるか？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:20",
  "hdr": "000D 0010",
  "jp": "それとも怪人が好きなタイプか？{n}いや、それはいい。話がそれた。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:21",
  "hdr": "000D 0010",
  "jp": "町はこの桜の話題で{n}持ちきりだろう？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:22",
  "hdr": "000D 0010",
  "jp": "ん？　そんなことないか？{n}桜なんて花見の時以外どうでもいいか。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:23",
  "hdr": "000D 0010",
  "jp": "桜ってのは、この季節には咲かない。{n}普通なら今頃は丸ハダカだ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:24",
  "hdr": "000D 0010",
  "jp": "ところがどうだ。{n}この桜は狂おしいほどに満開だ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:25",
  "hdr": "000D 0010",
  "jp": "これはとても悲しいことなんだ。{n}なぜなら……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:26",
  "hdr": "000D 0010",
  "jp": "桜が一生のあいだに咲く回数は{n}決まっている。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:27",
  "hdr": "000D 0010",
  "jp": "なのに、この桜は一生分の力を{n}使い果たそうとしている。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:28",
  "hdr": "000D 0010",
  "jp": "あと何日かしたら花は散り{n}木もそのまま枯れてしまうだろう。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:29",
  "hdr": "000D 0010",
  "jp": "来年の春は……もう咲かないよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:30",
  "hdr": "000D 0010",
  "jp": "どうしてかって？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:31",
  "hdr": "000D 0010",
  "jp": "実はおじさんは答えを知っている。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:32",
  "hdr": "000D 0010",
  "jp": "答えを知る者の義務として{n}おれは桜を助けたい。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:33",
  "hdr": "000D 0010",
  "jp": "しかし、おれじゃダメなんだ。{n}七海のほおをぬらす涙がほしい！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:34",
  "hdr": "000D 0010",
  "jp": "……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:35",
  "hdr": "000D 0010",
  "jp": "いや、これじゃ誤解されるな。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:36",
  "hdr": "000D 0010",
  "jp": "おれはヒーローをさがしている。{n}七海を助け、桜を助けるヒーロー！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:37",
  "hdr": "000D 0010",
  "jp": "そして、桜を助けることは{n}町を救うことにもなる。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:38",
  "hdr": "000D 0010",
  "jp": "どうだ？{n}使命感に胸が高鳴るだろう？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:39",
  "hdr": "FFFF 00FF",
  "jp": "少年は思った。{n}ぼくとこの変なおじさんでは{n}どっちの足が速いだろう、と。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:40",
  "hdr": "FFFF 00FF",
  "jp": "ダッシュすればだいじょうぶ。{n}きっと、逃げられる。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:41",
  "hdr": "000D 0010",
  "jp": "あれ？　盛り上がってない？{n}だからどうしたって感じ？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:42",
  "hdr": "000D 0010",
  "jp": "おれの見込みちがいかな……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:43",
  "hdr": "000D 0010",
  "jp": "おっ！　穴？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:44",
  "hdr": "000D 0010",
  "jp": "なんで今になって！？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:45",
  "hdr": "0017 000D",
  "jp": "わん！　わわわわん！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:46",
  "hdr": "0004 000D",
  "jp": "どこへ行くんですか！？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:47",
  "hdr": "0017 000D",
  "jp": "わうーん……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:48",
  "hdr": "0004 000D",
  "jp": "わうーん……{n}{col_F8}(助けてください……)",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:49",
  "hdr": "FFFF 00FF",
  "jp": "女の子が倒れていた。{n}学校で見かけた子。{n}ナスカイザーハンカチの持ち主。{n}この子が……七海？{n}倒れているって、どういうこと？{n}もしかして、これは大事件？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:50",
  "hdr": "002E 000F",
  "jp": "うーん……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:51",
  "hdr": "0017 000D",
  "jp": "はひー　はひー！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:52",
  "hdr": "0004 000D",
  "jp": "はひー　はひー！{n}{col_F8}(七海さん、良かったですー)",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:53",
  "hdr": "002E 000F",
  "jp": "ここは……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:54",
  "hdr": "002E 000F",
  "jp": "あれ？　きみ、学校にいたよね？{n}咲谷小学校の生徒でしょ？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:55",
  "hdr": "002E 000F",
  "jp": "わたしは吉田七海。{n}この子は{var_ED}{slot}{slot}{slot}{slot}{slot}。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:56",
  "hdr": "002E 000F",
  "jp": "今日、高台3丁目に越してきたの。{n}さっきは転校の手続きに……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:57",
  "hdr": "002E 000F",
  "jp": "ねえ、変なおじさん見なかった？{n}気味の悪い顔のおじさんよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:58",
  "hdr": "002E 000F",
  "jp": "散歩していたら、会っちゃったの。{n}わたし、誘拐されかけたのかも……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:59",
  "hdr": "002E 000F",
  "jp": "でも、あまり怖くはなかったな……{n}どうしてだろう……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:60",
  "hdr": "002E 000F",
  "jp": "この桜、来年は咲かないんだよね。{n}それって……さびしいね。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:61",
  "hdr": "002E 000F",
  "jp": "あれ……？　わたし、どうして{n}そんなこと知ってるんだろう。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:62",
  "hdr": "002E 000F",
  "jp": "やだ、涙が出ちゃった……どうして？{n}もう泣かないって決めたのに……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:63",
  "hdr": "002E 000F",
  "jp": "ハンカチハンカチ……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:64",
  "hdr": "002E 000F",
  "jp": "もう……{n}ハンカチ落としちゃった。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:65",
  "hdr": "FFFF 00FF",
  "jp": "少年は思った。{n}この七海って子は……{n}なんだか変だ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:66",
  "hdr": "FFFF 00FF",
  "jp": "さっきからブツブツと……{n}ひとりごと？　ぼくに言ってるの？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:67",
  "hdr": "FFFF 00FF",
  "jp": "よし、こうしよう。{n}ガンタたちが拾った七海のハンカチ。{n}さっさと返してサヨウナラ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:68",
  "hdr": "002E 000F",
  "jp": "わあ、ありがとう！　借りるね。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:69",
  "hdr": "002E 000F",
  "jp": "いやっ！{n}これ、わたしの！？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:70",
  "hdr": "002E 000F",
  "jp": "そうか、学校で落としたんだ。{n}拾ってくれたのね？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:71",
  "hdr": "002E 000F",
  "jp": "でも、こんなハンカチ持ってること{n}誰にも言わないで！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:72",
  "hdr": "002E 000F",
  "jp": "ナスカイザーはね、ママが好きなの。{n}わたしの趣味じゃないんだから。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:73",
  "hdr": "002E 000F",
  "jp": "そうだ、このハンカチ、あげる。{n}助けてくれたお礼よ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:74",
  "hdr": "0004 000D",
  "jp": "くいーん……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:75",
  "hdr": "0004 000D",
  "jp": "くいーん……{n}{col_F8}(ボクも欲しいです……)",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:76",
  "hdr": "002E 000F",
  "jp": "そうだね、帰ろうか、{var_ED}{slot}{slot}{slot}{slot}{slot}。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:77",
  "hdr": "0004 000D",
  "jp": "くいーん……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:78",
  "hdr": "0004 000D",
  "jp": "くいーん……{n}{col_F8}(通じません……)",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:79",
  "hdr": "002E 000F",
  "jp": "ごめん、もう帰らなくちゃ。{n}{var_ED}{slot}{slot}{slot}{slot}{slot}、行こう。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:80",
  "hdr": "0004 000D",
  "jp": "わん！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:81",
  "hdr": "0004 000D",
  "jp": "わん！{n}{col_F8}(ありがとうです！)",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:82",
  "hdr": "FFFF 00FF",
  "jp": "散らない桜。{n}使い古しのハンカチをくれた{n}転校生の女子、七海。{n}わけがわからない変なおじさん。{n}おじさんはヒーローをさがしている。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:83",
  "hdr": "FFFF 00FF",
  "jp": "古代戦士ナスカイザー。{n}父親の仕事。{n}つながっているような、いないような……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:84",
  "hdr": "FFFF 00FF",
  "jp": "よくわからない。{n}そもそも、ぼくはどうして神社に？{n}そうだ、おつかいの途中だった！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:85",
  "hdr": "00FF 000C",
  "jp": "「七海の涙を手に入れた！」",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:86",
  "hdr": "00FF 000C",
  "jp": "桜の木の裏にはもう誰もいない。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:87",
  "hdr": "00FF 000C",
  "jp": "ずいぶん時間がたってしまった。{n}スーパーへ向かおう。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:88",
  "hdr": "0018 0014",
  "jp": "ああ、{var_EF}{slot}{slot}{slot}{slot}{slot}ちゃん。{n}ミリンを取りに来たんでしょ？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:89",
  "hdr": "0018 0014",
  "jp": "はい、これ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2500:90",
  "hdr": "0018 0014",
  "jp": "ねえ、{var_EF}{slot}{slot}{slot}{slot}{slot}ちゃん。{n}お母さん、だいじょうぶかい？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
