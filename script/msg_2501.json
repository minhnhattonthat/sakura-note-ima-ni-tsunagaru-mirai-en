[
 {
  "id": "2501:0",
  "hdr": "FFFF 00FF",
  "jp": "少年が家に帰ると両親はいなかった。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2501:1",
  "hdr": "FFFF 00FF",
  "jp": "「急用ででかけます。{n}　ごはんまでには帰ります」{n}母親が書いたメモがあった。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2501:2",
  "hdr": "0006 0014",
  "jp": "ごめん、おそくなっちゃった。{n}お父さんは？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2501:3",
  "hdr": "0006 0014",
  "jp": "そう、まだなのね。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2501:4",
  "hdr": "0006 0014",
  "jp": "ナスカイザーが終わってすぐに{n}電話があって、出かけていったのよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2501:5",
  "hdr": "0006 0014",
  "jp": "急いでごはん作るからね。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2501:6",
  "hdr": "FFFF 00FF",
  "jp": "家の中に豚バラ煮込みのニオイが{n}立ちこめるころ、父親が帰って来た。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2501:7",
  "hdr": "00FF 000C",
  "jp": "今日はもう、外へ出るのはやめておこう。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2501:8",
  "hdr": "0005 0012",
  "jp": "ただいまー。{n}{var_EE}{slot}{slot}{slot}{slot}{slot}も帰ったよー。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2501:9",
  "hdr": "0005 0012",
  "jp": "いやー、打ち合わせはキライだな。{n}移動時間がもったいなくてさ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2501:10",
  "hdr": "0005 0012",
  "jp": "おっ、このニオイ！{n}豚バラの煮込み！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2501:11",
  "hdr": "0006 0014",
  "jp": "……外で食べてくるんだと思った。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2501:12",
  "hdr": "0005 0012",
  "jp": "……なんで？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2501:13",
  "hdr": "0006 0014",
  "jp": "カンよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2501:14",
  "hdr": "0005 0012",
  "jp": "……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2501:15",
  "hdr": "0005 0012",
  "jp": "そうだ、取り引き先で{n}お土産をもらったよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2501:16",
  "hdr": "0005 0012",
  "jp": "《大桜餅(だいさくらもち)》{n}っていうんだってさ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2501:17",
  "hdr": "0006 0014",
  "jp": "わたしはいらないわ。{n}そんなもの。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2501:18",
  "hdr": "0005 0012",
  "jp": "……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
