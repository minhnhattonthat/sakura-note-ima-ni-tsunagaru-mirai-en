  "notes": ""
 },
 {
  "id": "2501:27",
  "hdr": "0006 0014",
  "jp": "{var_EF}{slot}{slot}{slot}{slot}{slot}、ハグさせて。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2501:28",
  "hdr": "0006 0014",
  "jp": "電話か……きっとお父さんは外出よ。{n}今夜もふたりきりね。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2501:29",
  "hdr": "0005 0012",
  "jp": "ちょっと行ってくる。{n}バグ、父さんが原因だった。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2501:30",
  "hdr": "0006 0014",
  "jp": "ほーら、ね。",
