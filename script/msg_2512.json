[
 {
  "id": "2512:0",
  "hdr": "0030 0017",
  "jp": "ようこそ、私たちの学校へ……{n}　",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2512:1",
  "hdr": "0030 0017",
  "jp": "ぜひ、あなた達には{n}この学校で学んでいただきたい。{page}ちなみに、{n}この学校には卒業式はありません。{page}その名も……冥界大学付属妖怪学園。{n}残念ながら女学園ではありません。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2512:2",
  "hdr": "0030 0017",
  "jp": "待ち構えるのは、{n}しごきと恐怖のみです。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2512:3",
  "hdr": "0030 0017",
  "jp": "ところであなた……{page}妖怪には学校も、試験もなんにもないと{n}お思いだったでしょう？{page}そんな心構えでは{n}我が校の試験に失格です。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2512:4",
  "hdr": "0030 0017",
  "jp": "サクラも散るわけです。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2512:5",
  "hdr": "0030 0017",
  "jp": "さて、試験はこれくらいにします。{n}もうあなたは合格。{page}なぜって？{n}あなたに弱気や恐れを感じるからです。{page}私たちはそういう「気」を{n}何よりも好みます。{page}ずっと待ち構え……{n}いや、待っていたのです。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2512:6",
  "hdr": "0030 0017",
  "jp": "大切なご友人も、入学試験に合格して{n}さっそく勉学にいそしんでいます。{page}あなたやご友人には{n}闇がせまっています。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2512:7",
  "hdr": "0030 0017",
  "jp": "闇が怖いのなら、{n}勇気をふりしぼって下さい。{page}まあ、私たちは{n}それを望みませんけど……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2512:8",
  "hdr": "0030 0017",
  "jp": "校舎は西ブロックと東ブロックに{n}分かれています。{page}まずはゆっくり{n}見学するとよいでしょう。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2512:9",
  "hdr": "0030 0017",
  "jp": "あなたが、一生我が校の生徒で{n}あり続けることを祈ります……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2512:10",
  "hdr": "FFFF 00FF",
  "jp": "少年はひそかに興奮していた。{n}囚われの身となった友だちを助ける夢。{n}漠然と憧れていたストーリーを{n}夢で体験できた……{n}夢だよな、これ。{n}念のため、頬をつねったら痛かった！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
