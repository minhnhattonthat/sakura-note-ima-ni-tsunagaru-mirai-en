  "id": "2513:96",
  "hdr": "00FF 000C",
  "jp": "お金が無いから買えない！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:97",
  "hdr": "00FF 000C",
  "jp": "切符を買う大事なお金だ！{n}使ってしまうと困ったことになる……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:98",
  "hdr": "0007 000F",
  "jp": "ねぇ、{var_EF}{slot}{slot}{slot}{slot}{slot}くん。{n}なにか悪いことたくらんでない？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:99",
  "hdr": "0007 000F",
  "jp": "だめだよ！{n}私たちは正義の味方なんだから！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:100",
  "hdr": "003E 0013",
  "jp": "いらっしゃいませー。{n}CVSへようこそー。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:101",
  "hdr": "003D 0012",
  "jp": "週刊ヨムヨムか、ナスカイザー大百科{n}どっちにしようか迷うなぁ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:102",
  "hdr": "002B 0014",
  "jp": "今日の晩御飯なににするー？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:103",
  "hdr": "002A 0012",
  "jp": "丘下産まるまる豚のあつあつソテー{n}あまからハチミツジンジャー風味……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:104",
  "hdr": "002A 0012",
  "jp": "……なんてどうかな。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:105",
  "hdr": "002B 0014",
  "jp": "ああ、ようするに豚のしょうが焼きね。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:106",
  "hdr": "002A 0012",
  "jp": "のりが悪いな。{n}もっとしょうが焼きにおしゃれ感を！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:107",
  "hdr": "002B 0014",
  "jp": "じゃあ、今晩はしょうが焼きにしよう。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:108",
  "hdr": "003F 0011",
  "jp": "ガキがぞろぞろうっとうしいぜ……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:109",
  "hdr": "003F 0011",
  "jp": "なんだ、仲間はずれで一人ぼっちか？{n}だっせー！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:110",
  "hdr": "00FF 000C",
  "jp": "こっちはスーパーの事務所だ。{n}勝手に入ると怒られそう。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:111",
  "hdr": "00FF 000C",
  "jp": "大量のおかしやジュースがつんである。{n}すこし、キイチがうらやましい。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:112",
  "hdr": "00FF 000C",
  "jp": "マルケンのオリジナル商品も{n}あるみたいだ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:113",
  "hdr": "003B 0012",
  "jp": "バスって乗るのに勇気がいるよ。{n}後戻りができない感じがするじゃない。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:114",
  "hdr": "003C 0013",
  "jp": "おじいちゃん、おばあちゃん{n}また遊びにくるね！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:115",
  "hdr": "0039 0012",
  "jp": "楽しいと、あっという間に{n}時間が過ぎるなぁ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:116",
  "hdr": "0038 0014",
  "jp": "次の連休がまちどおしいね。{n}またおいで。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:117",
  "hdr": "00FF 000C",
  "jp": "こっちの階段は{n}工事中で使えないようだ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:118",
  "hdr": "002A 0012",
  "jp": "俺、駅前シンガーとして{n}デビューするんだ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:119",
  "hdr": "002A 0012",
  "jp": "楽器なんにもできないんだけどね。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:120",
  "hdr": "00FF 000C",
  "jp": "宝くじ売り場だ。{n}残りのお年玉じゃ足りない……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:121",
  "hdr": "002A 0012",
  "jp": "これもハズレ。{n}あ、これもハズレだ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:122",
  "hdr": "002A 0012",
  "jp": "宝くじぜーんぶハズレたよ！{n}俺って運ないのかなぁ……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:123",
  "hdr": "003B 0012",
  "jp": "咲谷は活気があるね。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:124",
  "hdr": "003B 0012",
  "jp": "仕事で桐谷に行ったんだけど{n}少し、さびしい感じがしたよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:125",
  "hdr": "003B 0012",
  "jp": "いや、さびしいって言うより{n}なんか変だったかな。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:126",
  "hdr": "0018 0014",
  "jp": "あら、みんなでおでかけ？{n}いってらっしゃい。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:127",
  "hdr": "0007 000F",
  "jp": "{var_EF}{slot}{slot}{slot}{slot}{slot}くん、早く行こう！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:128",
  "hdr": "00FF 000C",
  "jp": "こんなことしてる場合じゃない！{n}はやく行かなければ！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:129",
  "hdr": "0047 0014",
  "jp": "{var_EF}{slot}{slot}{slot}{slot}{slot}ちゃん、お母さん元気？{n}おばさんちょっとシンパイだわ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:130",
  "hdr": "0067 00FF",
  "jp": "この前、私が見たときは{n}なんかフラフラしてたよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:131",
  "hdr": "0018 0014",
  "jp": "あれ？　{var_EF}{slot}{slot}{slot}{slot}{slot}ちゃん。{n}キイチとはいっしょじゃないの？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:132",
  "hdr": "00FF 000C",
  "jp": "サイドテーブルの下に{n}なにかある……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:133",
  "hdr": "0045 0011",
  "jp": "あ、この前の君か！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:134",
  "hdr": "0045 0011",
  "jp": "君の言ったとおり、たまねぎだったよ。{n}おいしいカレーごちそうさま！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:135",
  "hdr": "0045 0011",
  "jp": "たのまれたおつかいは{n}なっとうじゃなかったよ！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:136",
  "hdr": "0045 0011",
  "jp": "でも、なっとうカレーも悪くないね！{n}なんかクセになる味わいだよ、アレ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:137",
  "hdr": "0045 0011",
  "jp": "あらたなフィールドにふみこんだ感じ？{n}あれを知らないなんて、人生ソンだよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:138",
  "hdr": "0045 0011",
  "jp": "教えてくれて、ありがとな！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:139",
  "hdr": "004F 0011",
  "jp": "おじいちゃんのやられかた{n}なんか、ちょっとちがうよ！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:140",
  "hdr": "004F 0011",
  "jp": "お兄ちゃんの{n}やられかたみせて！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:141",
  "hdr": "004F 0011",
  "jp": "お兄ちゃん、すっごい！{n}おじいちゃん見習ってよ！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:142",
  "hdr": "004F 0011",
  "jp": "ううん……{n}おじいちゃんの方がうまいなぁ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:143",
  "hdr": "0050 0012",
  "jp": "今度は、やられかたを{n}教えてくれんか……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:144",
  "hdr": "0050 0012",
  "jp": "わしのためにわざと……{n}うう、ありがとう……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:145",
  "hdr": "000E 0012",
  "jp": "やぁ{var_EF}{slot}{slot}{slot}{slot}{slot}くん、こんにちは。{n}{var_EE}{slot}{slot}{slot}{slot}{slot}を探しに来たのかい？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:146",
  "hdr": "00FF 000C",
  "jp": "ナスカイザーの等身大人形だ。{n}よくみると関係者のサインがかいてある。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:147",
  "hdr": "00FF 000C",
  "jp": "ちょっとした雑貨を売っている。{n}ゆでたまごは人気商品のようだ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:148",
  "hdr": "002A 0012",
  "jp": "あ、これ？　ひけないけど買っちゃって{n}あとにひけないギターです。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:149",
  "hdr": "00FF 000C",
  "jp": "桜を救う……{n}ガンタとキイチは信じるだろうか……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:150",
  "hdr": "0068 0014",
  "jp": "穴をふさげる物はないかしら？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:151",
  "hdr": "002A 0012",
  "jp": "大人達からうまく逃げ切れたようだね。{n}間に挟まれてどうしようかと思ったよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2513:152",
  "hdr": "002A 0012",
  "jp": "大人はわかっちゃくれないのさ。{n}わかる、わかるよ今の君の気持ち……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
