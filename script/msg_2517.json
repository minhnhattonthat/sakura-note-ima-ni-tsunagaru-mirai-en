  "notes": ""
 },
 {
  "id": "2517:6",
  "hdr": "000B 0011",
  "jp": "平和な風景……",
  "en": "Looks peaceful...",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2517:7",
  "hdr": "0007 000F",
  "jp": "そんな……あ、そうだ！",
