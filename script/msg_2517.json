[
 {
  "id": "2517:0",
  "hdr": "FFFF 00FF",
  "jp": "少年は思った。{n}先生たちと出会ったら面倒だ……",
  "en": "The boy thought running into{n}Nobiyo-sensei and the other teachers{n}would mean trouble...",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2517:1",
  "hdr": "FFFF 00FF",
  "jp": "しかし、誰にも会わずに屋上まで{n}行くことができた。",
  "en": "But they made it all the way to the roof{n}without meeting anyone.",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2517:2",
  "hdr": "FFFF 00FF",
  "jp": "大人にも、妖怪にも、会わなかった。",
  "en": "No adults. No yokai.",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2517:3",
  "hdr": "0007 000F",
  "jp": "ね！？　見えるでしょ？",
  "en": "See!? You can see it, right?",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2517:4",
  "hdr": "0007 000F",
  "jp": "神社から出た桜の《気》が{n}マンションにぶつかって……",
  "en": "The cherry tree's spiritual energy{n}comes from the shrine...{page}Then it hits the apartment tower...",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2517:5",
  "hdr": "000A 0013",
  "jp": "なーんにも見えない。",
  "en": "I don't see a single thing.",
