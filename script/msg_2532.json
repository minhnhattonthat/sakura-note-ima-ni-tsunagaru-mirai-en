  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:32",
  "hdr": "0003 000E",
  "jp": "ちょっと待ってね。{n}下で何かはじまった。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:33",
  "hdr": "FF19 00FF",
  "jp": "妖怪が……《気》を……奪う……{n}わたしの……大切な……《気》……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:34",
  "hdr": "0003 000E",
  "jp": "ホントだ！{n}あれはまさしく妖怪！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:35",
  "hdr": "0003 000E",
