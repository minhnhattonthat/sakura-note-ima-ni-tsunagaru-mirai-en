[
 {
  "id": "2532:0",
  "hdr": "0003 000E",
  "jp": "……この世の者じゃないよね？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:1",
  "hdr": "000D 0010",
  "jp": "げっ。妖怪より怖い年増猫。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:2",
  "hdr": "0003 000E",
  "jp": "失礼じゃない？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:3",
  "hdr": "000D 0010",
  "jp": "おれは猫に用はないんだよ。{n}おれが探しているのは七海って女の子。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:4",
  "hdr": "000D 0010",
  "jp": "この町にいるはずなんだよね。{n}桜を救うには七海が必要なんだ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:5",
  "hdr": "0003 000E",
  "jp": "桜を救う？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:6",
  "hdr": "000D 0010",
  "jp": "猫ならわかるだろ？{n}で、七海の居場所、知らない？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:7",
  "hdr": "0003 000E",
  "jp": "知らないよ、そんな子。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:8",
  "hdr": "00FF 000C",
  "jp": "桜の木が気になる……{n}境内へ行ってみよう。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:9",
  "hdr": "000D 0010",
  "jp": "ヒーローよ、いずこ。{n}この際、ヒロインでもいい……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:10",
  "hdr": "0003 000E",
  "jp": "なつかしい……{n}もう10年前か。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:11",
  "hdr": "FFFF 00FF",
  "jp": "わたしはここに捨てられて{n}ミャーミャー泣いていた。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:12",
  "hdr": "FFFF 00FF",
  "jp": "そんなわたしをハルカは家へ{n}連れて帰ってくれた。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:13",
  "hdr": "FFFF 00FF",
  "jp": "あの頃、ハルカは毎日のように{n}ここにお参りに来ていた。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:14",
  "hdr": "FFFF 00FF",
  "jp": "子供を授かりますように、ってね。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:15",
  "hdr": "0003 000E",
  "jp": "せめてもの恩返しに、ハルカの{n}願いをかなえてくれないか……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:16",
  "hdr": "0003 000E",
  "jp": "わたしはそう桜にたのんだっけ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:17",
  "hdr": "0003 000E",
  "jp": "そのせいかどうか知らないけど{n}すぐに{var_EF}{slot}{slot}{slot}{slot}{slot}ができた……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:18",
  "hdr": "0003 000E",
  "jp": "こんにちは、桜さん。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:19",
  "hdr": "0003 000E",
  "jp": "ねえ、もう春はとっくに終わったよ。{n}どうしてまだがんばってるんだい？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:20",
  "hdr": "0003 000E",
  "jp": "……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:21",
  "hdr": "FF19 00FF",
  "jp": "…………",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:22",
  "hdr": "0003 000E",
  "jp": "ああ。わたしとしたことが。{n}木と話す時は上へ登るんだ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:23",
  "hdr": "0003 000E",
  "jp": "話せる？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:24",
  "hdr": "0003 000E",
  "jp": "わたしで役に立てることがあるかな？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:25",
  "hdr": "FF19 00FF",
  "jp": "あの子が……死んでしまう……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:26",
  "hdr": "0003 000E",
  "jp": "あの子？　どこの子？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:27",
  "hdr": "FF19 00FF",
  "jp": "力を……送らないと……{n}わたしの《気》を……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:28",
  "hdr": "0003 000E",
  "jp": "《気》を送るために咲いてるの？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:29",
  "hdr": "0003 000E",
  "jp": "誰を助けるにしても、これじゃあ{n}自分が危ないでしょ？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:30",
  "hdr": "FF19 00FF",
  "jp": "お願い……塔が……邪魔なの……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2532:31",
  "hdr": "0003 000E",
  "jp": "塔？",
