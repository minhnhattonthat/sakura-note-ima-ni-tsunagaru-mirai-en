[
 {
  "id": "2538:0",
  "hdr": "003E 0013",
  "jp": "あ、ゴメンねネコちゃん。{n}当店はペットの入場禁止なの……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:1",
  "hdr": "003A 0014",
  "jp": "ちょっと、どういうこと！？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:2",
  "hdr": "002A 0011",
  "jp": "すごく楽しみにしてたのに～",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:3",
  "hdr": "0039 0012",
  "jp": "俺が並び続けた時間は{n}いったいなんだったんだ！！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:4",
  "hdr": "002B 0013",
  "jp": "行列をみかけたら、とにかく{n}ならんじゃうクセ、なおさなきゃ……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:5",
  "hdr": "00FF 000C",
  "jp": "本日、シェフのきまぐれにより{n}お休みさせていただきます。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:6",
  "hdr": "003B 0012",
  "jp": "ううん、娘の誕生日プレゼントが{n}まったく決まらない……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:7",
  "hdr": "003B 0012",
  "jp": "うん？{n}なんだ、猫か。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:8",
  "hdr": "003B 0012",
  "jp": "……そうだ、猫だ！{n}猫のぬいぐるみにしよう！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:9",
  "hdr": "003C 0013",
  "jp": "うーん、いいにおい！{n}なんだか食べれそう……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:10",
  "hdr": "003A 0014",
  "jp": "はやく使ってみたいね。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:11",
  "hdr": "00FF 000C",
  "jp": "せっけんやシャンプーが{n}たくさん並んでいる。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:12",
  "hdr": "003B 0012",
  "jp": "ううむ、ナイスチョイス。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:13",
  "hdr": "0024 0010",
  "jp": "おお、えらいことになってるな。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:14",
  "hdr": "0003 000E",
  "jp": "アンタが原因なんでしょ？{n}ひとごとみたいに言わないの！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:15",
  "hdr": "0024 0010",
  "jp": "いや、まったくもってそのとおり。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:16",
  "hdr": "0024 0010",
  "jp": "早いとこ、七海をみつけて{n}契約を更新しなきゃな。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:17",
  "hdr": "0003 000E",
  "jp": "……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:18",
  "hdr": "005A 0013",
  "jp": "お、お客様！{n}おちついて～！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:19",
  "hdr": "002B 0013",
  "jp": "ねぇ、聞いてる？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:20",
  "hdr": "002A 0011",
  "jp": "お、猫だ。{n}アイス食う？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:21",
  "hdr": "003B 0012",
  "jp": "俺のアイスが消えた！{n}消えたよ！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:22",
  "hdr": "0003 000E",
  "jp": "……人間には、わたしたちの言葉は{n}通じないからなぁ。あてにできないか。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:23",
  "hdr": "0003 000E",
  "jp": "こっちはわたしのことなんか{n}眼中にないみたいだね。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:24",
  "hdr": "0062 0012",
  "jp": "迷い猫……か。{n}昔を思い出すな。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:25",
  "hdr": "0062 0012",
  "jp": "あの頃の俺は、お前みたいに{n}ぎらぎらした目をしていたよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:26",
  "hdr": "0062 0012",
  "jp": "そんなある日{n}俺はアイツと出会ったんだ……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:27",
  "hdr": "0003 000E",
  "jp": "長くなりそうだ。{n}さっさと七海を探さなきゃ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:28",
  "hdr": "0062 0012",
  "jp": "その時、アイツはこう言ったのさ。{n}俺達は一生の友達だ……ってね。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:29",
  "hdr": "002A 0011",
  "jp": "ああー！{n}疲れたよー！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:30",
  "hdr": "002B 0013",
  "jp": "はいはい、お疲れ様！{n}荷物持ちありがとね。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2538:31",
  "hdr": "0003 000E",
  "jp": "おおきいとかげだ。{n}あとでハルカにみせてやろう。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
