  "jp": "やあ、{var_EE}{slot}{slot}{slot}{slot}{slot}。{n}また、ひとりで来たのか？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2551:1",
  "hdr": "000E 0012",
  "jp": "参ったな……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2551:2",
  "hdr": "000E 0012",
  "jp": "でも、一応、聞かせてもらおうか。{n}どこが悪いんだい？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2551:3",
  "hdr": "0003 000E",
  "jp": "にゃー……{n}{col_FA}(そこのインコにちょっとね)",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2551:4",
  "hdr": "000E 0012",
  "jp": "え？　おなかが痛い？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2551:5",
  "hdr": "0003 000E",
  "jp": "にゃ……{n}{col_FA}(もう、いいよ)",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2551:6",
  "hdr": "000E 0012",
  "jp": "なんだ、ひやかしか。{n}ま、ごゆっくり。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2551:7",
  "hdr": "000E 0012",
  "jp": "ぼくはちょっと休憩ね。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2551:8",
  "hdr": "0020 0015",
  "jp": "鳥の宿敵、猫め。{n}自分、何か用か？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2551:9",
  "hdr": "0003 000E",
  "jp": "頼みがあって来たんだ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2551:10",
  "hdr": "0003 000E",
  "jp": "さっきの医者は鳥の言葉が{n}わかるんだって？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2551:11",
  "hdr": "0003 000E",
  "jp": "だったらあの医者に{n}伝えてくれないか？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2551:12",
  "hdr": "0020 0015",
  "jp": "断る！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2551:13",
  "hdr": "0020 0015",
  "jp": "200年ほど前に{n}鳥幕府のお達しがあった。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2551:14",
  "hdr": "0020 0015",
  "jp": "人間と会話した鳥は{n}羽むしりの上釜ゆで。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2551:15",
  "hdr": "0003 000E",
  "jp": "幕府って……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2551:16",
  "hdr": "0020 0015",
  "jp": "バカにするな。{n}鳥にだって幕府くらいある！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2551:17",
  "hdr": "0003 000E",
  "jp": "悪かったよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2551:18",
  "hdr": "0020 0015",
  "jp": "いいだろう。許す。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2551:19",
  "hdr": "0020 0015",
  "jp": "まあ、人間と動物は、それくらいの{n}付き合いがいいのさ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2551:20",
  "hdr": "0003 000E",
  "jp": "でも、今は町の一大事なんだ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2551:21",
  "hdr": "0003 000E",
  "jp": "このままじゃ、町は妖怪のものに{n}なってしまうよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2551:22",
  "hdr": "0020 0015",
  "jp": "鳥はどこへでも飛んでいける。{n}町がどうなろうと、知ったことか。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2551:23",
  "hdr": "0003 000E",
  "jp": "……その足カセを{n}どうやってはずすのさ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2551:24",
  "hdr": "0003 000E",
  "jp": "頼みを聞いてくれたら{n}わたしがなんとかしてやるよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2551:25",
  "hdr": "0020 0015",
  "jp": "……………………ピ！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2551:26",
  "hdr": "0020 0015",
  "jp": "………………ピュウ！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2551:27",
  "hdr": "0020 0015",
  "jp": "取り引き成立。{n}で、何を伝えればいんだ？",
  "en": "",
  "status": "todo",
