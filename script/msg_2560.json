[
 {
  "id": "2560:0",
  "hdr": "0005 0012",
  "jp": "なんで、ナスカ……",
  "en": "Why are we in Nazca...?",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2560:1",
  "hdr": "0003 000E",
  "jp": "ずっと見たがっていたでしょ。",
  "en": "You've always wanted to see it.",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2560:2",
  "hdr": "0005 0012",
  "jp": "そうだけどさ……",
  "en": "Well, sure, but...",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2560:3",
  "hdr": "0005 0012",
  "jp": "え？　{var_EE}{slot}{slot}{slot}{slot}{slot}！{n}今、しゃべった！？",
  "en": "Huh? {var_EE}{slot}{slot}{slot}{slot}{slot}!{n}Did you just talk!?",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2560:4",
  "hdr": "0003 000E",
  "jp": "不思議でもなんでもないよ。{n}あたしたち死んだんだから。",
  "en": "There's nothing strange about it.{n}We're dead, after all.",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2560:5",
  "hdr": "0005 0012",
  "jp": "あ、そうか……{n}いや、マズイよ、それはマズイ！",
  "en": "Oh, right...{n}No, that's bad! That's really bad!",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2560:6",
  "hdr": "0028 0016",
  "jp": "マズくてもどうしようもないなぁ。",
  "en": "Bad or not, nothing you can do.",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2560:7",
  "hdr": "0005 0012",
  "jp": "って、誰ですか！？",
  "en": "Wait, who are you!?",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2560:8",
  "hdr": "0028 0016",
  "jp": "この上に、奉行所がある。{n}おれは案内人さ。",
  "en": "The magistrate's court is up there.{n}I'm your guide.",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2560:9",
  "hdr": "0005 0012",
  "jp": "奉行所！？　しかもナスカの上？",
  "en": "A magistrate's court!? Above Nazca?",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2560:10",
  "hdr": "0028 0016",
  "jp": "地上絵はおまえへの贈り物。{n}幕府の粋なはからいだ。",
  "en": "The geoglyphs are a gift for you.{n}A kind gesture by the Bird Shogunate.",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2560:11",
  "hdr": "0005 0012",
  "jp": "ば、幕府！？",
  "en": "The B-Bird Shogunate!?",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2560:12",
  "hdr": "0005 0012",
  "jp": "この人たちは……",
  "en": "These people...",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2560:13",
  "hdr": "0003 000E",
  "jp": "明らかに亡者だね……",
  "en": "Departed souls, obviously...",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2560:14",
  "hdr": "0005 0012",
  "jp": "ぼくも……亡者？",
  "en": "I'm... a departed soul too?",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2560:15",
  "hdr": "0003 000E",
  "jp": "残念だけどね……",
  "en": "Afraid so...",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2560:16",
  "hdr": "0005 0012",
  "jp": "やだな……気持ち悪いよ……",
  "en": "I don't like this... It's creepy...",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2560:17",
  "hdr": "0003 000E",
  "jp": "あ！　あんたは！！",
  "en": "Ah! You!!",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2560:18",
  "hdr": "0024 0010",
  "jp": "あんたら！{n}死んじまったのか！？",
  "en": "You lot!{n}You went and died!?",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2560:19",
  "hdr": "0024 0010",
  "jp": "いや、そんなことより{n}七海は？　桜は？",
  "en": "Never mind that.{n}What about Nanami? The cherry tree?",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2560:20",
  "hdr": "0005 0012",
  "jp": "そんなこと「より」って……ないよねえ",
  "en": "\"Never mind that\"?{n}That's a bit harsh, isn't it?",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2560:21",
  "hdr": "0005 0012",
  "jp": "でもあの人、見たことあるよ。{n}そうか、あれが重要人物！？",
  "en": "But I've seen him before.{n}Oh! Is he our key person!?",
  "status": "done",
  "notes": ""
 }
]
