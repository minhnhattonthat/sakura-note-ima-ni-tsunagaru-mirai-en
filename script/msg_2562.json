[
 {
  "id": "2562:0",
  "hdr": "0028 0016",
  "jp": "{var_F0}{slot}{slot}{slot}{slot}{slot}{sp}カナメ。{n}お裁きは間もなくだぞ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2562:1",
  "hdr": "0028 0016",
  "jp": "極楽へ行けるように、証言の{n}準備をしておくがいい。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2562:2",
  "hdr": "0005 0012",
  "jp": "はい、わかりました。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2562:3",
  "hdr": "0003 000E",
  "jp": "あんたはここで何してるのさ。{n}捕まってるようだけど。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2562:4",
  "hdr": "0024 0010",
  "jp": "御法度の契約をしたのさ。{n}妖怪との契約だ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2562:5",
  "hdr": "0024 0010",
  "jp": "前例がないからって、200年も{n}お裁き保留中の身よ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2562:6",
  "hdr": "0024 0010",
  "jp": "ずっとおとなしくしてたんだが……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2562:7",
  "hdr": "0024 0010",
  "jp": "最近ここへ来た亡者から、桐谷の桜が{n}枯れそうだって聞いたんだ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2562:8",
  "hdr": "0024 0010",
  "jp": "それで、おれは契約切れのことを{n}思い出した。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2562:9",
  "hdr": "0024 0010",
  "jp": "桐谷の桜はおれが面倒を見た{n}かわいい木だ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2562:10",
  "hdr": "0024 0010",
  "jp": "なんとか助けてやりたいと思って{n}おれは強く念じて……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2562:11",
  "hdr": "0024 0010",
  "jp": "呪われるの覚悟で地上へ{n}戻ったんだ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2562:12",
  "hdr": "0024 0010",
  "jp": "子孫に契約の更新のやり方を{n}なんとしても伝えたかった。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2562:13",
  "hdr": "0003 000E",
  "jp": "妖怪との契約……御法度……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2562:14",
  "hdr": "0003 000E",
  "jp": "あんた、それを子孫の七海に{n}やらせようとしたのかい？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2562:15",
  "hdr": "0003 000E",
  "jp": "七海はどうなってもいいのかい。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2562:16",
  "hdr": "0024 0010",
  "jp": "んあああ……それを言うな。{n}でも、どうにかなると思ったんだ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2562:17",
  "hdr": "0024 0010",
  "jp": "契約じゃなくて、契約の更新だしな。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2562:18",
  "hdr": "0024 0010",
  "jp": "でも、桐谷へ行って驚いた。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2562:19",
  "hdr": "0024 0010",
  "jp": "更新には佐倉タカシと七海の協力が{n}必要なんだが……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2562:20",
  "hdr": "0024 0010",
  "jp": "七海は桐谷を出た後だった。{n}引っ越した直後よ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2562:21",
  "hdr": "0024 0010",
  "jp": "仕方がないからおれも{n}咲谷(さくや)町へ行ったんだ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2562:22",
  "hdr": "0024 0010",
  "jp": "そしたらおまえ、咲谷町が大変なことに{n}なっちまっててよ……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2562:23",
  "hdr": "0003 000E",
  "jp": "さかのぼれば、ぜんぶ{n}あんたのせい。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2562:24",
  "hdr": "0024 0010",
  "jp": "全面的に認めるよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 }
]
