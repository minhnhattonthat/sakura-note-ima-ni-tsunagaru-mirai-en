[
 {
  "id": "2563:0",
  "hdr": "0028 0016",
  "jp": "おい、{var_F0}{slot}{slot}{slot}{slot}{slot}{sp}カナメ。{n}時間だぞ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:1",
  "hdr": "0005 0012",
  "jp": "は、はい。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:2",
  "hdr": "0005 0012",
  "jp": "時間がありません。{n}契約の更新方法を教えてください。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:3",
  "hdr": "0024 0010",
  "jp": "おれが契約を結んだのは{n}キマヨイという妖怪だ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:4",
  "hdr": "0024 0010",
  "jp": "咲谷町の神社の桜から枝を{n}もらって……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:5",
  "hdr": "0024 0010",
  "jp": "桐谷で咲かせるのがおれの{n}夢だった。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:6",
  "hdr": "0024 0010",
  "jp": "ところが桐谷に植えた桜は{n}まったく育たない。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:7",
  "hdr": "0024 0010",
  "jp": "樹医の誇りをかけて世話をしたが{n}今にも枯れそうだ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:8",
  "hdr": "0024 0010",
  "jp": "そして、おれは気づいた。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:9",
  "hdr": "0024 0010",
  "jp": "その桜にはキマヨイという{n}妖怪がとりついていたんだ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:10",
  "hdr": "0024 0010",
  "jp": "だから、木が迷って、うまく{n}育たなかったんだな。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:11",
  "hdr": "0005 0012",
  "jp": "キマヨイ……木が迷う……あはは。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:12",
  "hdr": "0024 0010",
  "jp": "言っとくけど、200年前は{n}妖怪は普通にいたんだぞ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:13",
  "hdr": "0024 0010",
  "jp": "その中でもキマヨイは恐ろしい妖怪だ。{n}人間にとりつくと大変なことになる。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:14",
  "hdr": "0005 0012",
  "jp": "もしかして、気の迷いが……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:15",
  "hdr": "0024 0010",
  "jp": "そういうことだ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:16",
  "hdr": "0024 0010",
  "jp": "それで、おれはキマヨイに頼んだ。{n}どうか、おとなしくしてくれ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:17",
  "hdr": "0024 0010",
  "jp": "どうか、桜から出て行って{n}この木を元気にしてやってくれ、と。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:18",
  "hdr": "0024 0010",
  "jp": "すると、キマヨイは条件を{n}出して来た。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:19",
  "hdr": "0024 0010",
  "jp": "一番愛する者の涙を桜に注げ。{n}そうすれば200年、眠ってやる。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:20",
  "hdr": "0005 0012",
  "jp": "はぁ……でも、どういう意図が{n}あったんでしょうね、その条件。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:21",
  "hdr": "0024 0010",
  "jp": "知るか。相手はキマヨイだぞ？{n}理屈もなんもないんだろうよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:22",
  "hdr": "0024 0010",
  "jp": "とにかく、おれは、その条件を{n}のむしかなかった。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:23",
  "hdr": "0024 0010",
  "jp": "……おれには、おたねという名前の{n}娘がいたんだが……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:24",
  "hdr": "0005 0012",
  "jp": "一番愛する者、ですね？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:25",
  "hdr": "0024 0010",
  "jp": "そう。おれはおたねの涙を{n}桜に注いだってわけだ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:26",
  "hdr": "0024 0010",
  "jp": "キマヨイは契約を守って{n}桜は元気になったってわけだな。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:27",
  "hdr": "0005 0012",
  "jp": "それじゃあ、更新というのは{n}佐倉タカシさんが……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:28",
  "hdr": "0024 0010",
  "jp": "七海の涙を手に入れて桜に注ぐ。{n}ま、注ぐのは代理人でもいいかもな。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:29",
  "hdr": "0024 0010",
  "jp": "そうすれば……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:30",
  "hdr": "0024 0010",
  "jp": "桜は、また200年は元気に{n}咲き続けるだろうよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:31",
  "hdr": "0024 0010",
  "jp": "だからおれは七海を桐谷町へ{n}戻そうとあれやこれや……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:32",
  "hdr": "0024 0010",
  "jp": "でも、怖い思いさせて心が痛んだよ。{n}七海はおたねに似ていたしな……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:33",
  "hdr": "0028 0016",
  "jp": "{var_F0}{slot}{slot}{slot}{slot}{slot}{sp}カナメ！{n}何をしている！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:34",
  "hdr": "0028 0016",
  "jp": "お裁き拒否は即刻地獄行きだぞ！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:35",
  "hdr": "0005 0012",
  "jp": "はいっ！！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2563:36",
  "hdr": "0024 0010",
  "jp": "カナメさんよ。{n}子孫と桜を頼む。",
  "en": "",
  "status": "todo",
  "notes": ""
 }
]
