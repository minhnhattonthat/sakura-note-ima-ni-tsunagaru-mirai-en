[
 {
  "id": "2571:0",
  "hdr": "000D 0010",
  "jp": "秘密の穴よ！　穴よ開け！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:1",
  "hdr": "0004 000D",
  "jp": "七海さんを返せ！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:2",
  "hdr": "000D 0010",
  "jp": "そうはいかないぞ。{n}この子が必要なんだよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:3",
  "hdr": "000D 0010",
  "jp": "ちょっとだけ涙を{n}流してくれるだけでいいんだ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:4",
  "hdr": "0004 000D",
  "jp": "七海さんを泣かせる気ですか！？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:5",
  "hdr": "000D 0010",
  "jp": "仕方がないんだよ。{n}このままじゃマズイだろ？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:6",
  "hdr": "0004 000D",
  "jp": "何の話ですか！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:7",
  "hdr": "000D 0010",
  "jp": "イチイチうるさいよ、おまえ。{n}とにかくこの子を連れて……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:8",
  "hdr": "0004 000D",
  "jp": "あ、誘拐犯！{n}そんなことはボクが許さないぞ！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:9",
  "hdr": "000D 0010",
  "jp": "なんで犬コロに{n}じゃまされるんだ、もう。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:10",
  "hdr": "0004 000D",
  "jp": "七海さんはボクが守る！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:11",
  "hdr": "000D 0010",
  "jp": "おれは桜を守りたいんだよ！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:12",
  "hdr": "000D 0010",
  "jp": "……しかし、なんだな。{n}どうして、うまく行かない？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:13",
  "hdr": "000D 0010",
  "jp": "なんで穴が開かないんだ？{n}近道したいのに……地下で近道。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:14",
  "hdr": "000D 0010",
  "jp": "七海はおれの言うことなんて{n}聞いてくれそうにないし……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:15",
  "hdr": "0004 000D",
  "jp": "どこへ行くんですか！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:16",
  "hdr": "000D 0010",
  "jp": "いいこと思いついたんだ。{n}ヒロインとくればヒーローだ！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:17",
  "hdr": "0004 000D",
  "jp": "どうしよう……{n}七海さん、起きてくださいよう。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:18",
  "hdr": "0004 000D",
  "jp": "そうだ、助けを呼ぼう！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:19",
  "hdr": "0004 000D",
  "jp": "早く助けを呼びに行かなくちゃ！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:20",
  "hdr": "0004 000D",
  "jp": "わん？　わわわん、わわわん！{n}{col_F8}(えっ？　七海さんのニオイ！？)",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:21",
  "hdr": "0004 000D",
  "jp": "わんわんわんわん！{n}{col_F8}(助けてください！)",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:22",
  "hdr": "000D 0010",
  "jp": "なんか様子が変だよな……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:23",
  "hdr": "0004 000D",
  "jp": "おじさんのせいじゃないですか！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:24",
  "hdr": "000D 0010",
  "jp": "しっ！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:25",
  "hdr": "000D 0010",
  "jp": "怖がることはない。{n}おれははっきり言って紳士だ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:26",
  "hdr": "000D 0010",
  "jp": "少年、おまえさんは自分がヒーローだと{n}思ったことはあるか？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:27",
  "hdr": "000D 0010",
  "jp": "それとも怪人が好きなタイプか？{n}いや、それはいい。話がそれた。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:28",
  "hdr": "000D 0010",
  "jp": "町はこの桜の話題で{n}持ちきりだろう？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:29",
  "hdr": "000D 0010",
  "jp": "ん？　そんなことないか？{n}花見の時以外どうでもいいか。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:30",
  "hdr": "000D 0010",
  "jp": "本来、桜はこの季節には咲かない。{n}普通なら今頃は丸ハダカだ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:31",
  "hdr": "000D 0010",
  "jp": "ところがどうだ。{n}狂おしいほどに満開だ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:32",
  "hdr": "000D 0010",
  "jp": "これはとても悲しいことなんだ。{n}なぜなら……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:33",
  "hdr": "000D 0010",
  "jp": "桜が一生のあいだに咲く回数は{n}決まっている。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:34",
  "hdr": "000D 0010",
  "jp": "つまりこの桜は一生分の力を{n}使い果たそうとしている。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:35",
  "hdr": "000D 0010",
  "jp": "あと何日かしたら花は散り{n}そのまま枯れてしまうだろう。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:36",
  "hdr": "000D 0010",
  "jp": "来年の春は……もう咲かないよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:37",
  "hdr": "000D 0010",
  "jp": "バット、ホワイ？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:38",
  "hdr": "000D 0010",
  "jp": "それは……わからん。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:39",
  "hdr": "000D 0010",
  "jp": "桜の気持ちはわからんが{n}おれは桜を助けたい。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:40",
  "hdr": "000D 0010",
  "jp": "しかし、おれじゃダメだんだ。{n}なぜならおれは妖怪だから……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:41",
  "hdr": "000D 0010",
  "jp": "……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:42",
  "hdr": "000D 0010",
  "jp": "引くな。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:43",
  "hdr": "000D 0010",
  "jp": "おれはヒーローをさがしている。{n}桜を助けるヒーローを。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:44",
  "hdr": "000D 0010",
  "jp": "そして、桜を助けることは{n}町を救うことにもなる。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:45",
  "hdr": "000D 0010",
  "jp": "どうだ？{n}使命感に胸が高鳴るだろう？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:46",
  "hdr": "000D 0010",
  "jp": "あれ？　鳴らない？{n}だからどうしたって感じ？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:47",
  "hdr": "000D 0010",
  "jp": "こりゃまた、おれのカンちがいかな。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:48",
  "hdr": "000D 0010",
  "jp": "穴があったら入りたいよ、もう。{n}……って、穴があったよ！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:49",
  "hdr": "0004 000D",
  "jp": "どこへ行くんですか！？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:50",
  "hdr": "0004 000D",
  "jp": "わうーん……{n}{col_F8}(助けてください……)",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:51",
  "hdr": "002E 000F",
  "jp": "うーん……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:52",
  "hdr": "0004 000D",
  "jp": "はひー　はひー！{n}{col_F8}(七海さん、良かったですー)",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:53",
  "hdr": "002E 000F",
  "jp": "ここは……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:54",
  "hdr": "002E 000F",
  "jp": "あ！　学校で会ったよね！{n}あの学校の生徒だよね？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:55",
  "hdr": "002E 000F",
  "jp": "わたしは吉田七海。{n}この子は{var_ED}{slot}{slot}{slot}{slot}{slot}。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:56",
  "hdr": "002E 000F",
  "jp": "昨日高台3丁目に越してきたの。{n}二学期からは同じ学校だよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:57",
  "hdr": "002E 000F",
  "jp": "ねえ、変なおじさん知らない？{n}忙しそうにしてる人。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:58",
  "hdr": "002E 000F",
  "jp": "散歩していたら、会っちゃったの。{n}わたし、誘拐されかけたのかも……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:59",
  "hdr": "002E 000F",
  "jp": "なんか、変な感じ。{n}夢だったのかな……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:60",
  "hdr": "002E 000F",
  "jp": "この桜、来年は咲かないのね。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:61",
  "hdr": "002E 000F",
  "jp": "さびしいね。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:62",
  "hdr": "002E 000F",
  "jp": "あれっ？　涙が……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:63",
  "hdr": "002E 000F",
  "jp": "ハンカチハンカチ……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:64",
  "hdr": "002E 000F",
  "jp": "やだ。{n}ハンカチ落としちゃった……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:65",
  "hdr": "002E 000F",
  "jp": "わあ、ありがとう！　借りるね。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:66",
  "hdr": "002E 000F",
  "jp": "いやっ！{n}これ、わたしの！？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:67",
  "hdr": "002E 000F",
  "jp": "そうか、拾ってくれたのね。{n}学校で落としたんだ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:68",
  "hdr": "002E 000F",
  "jp": "でも、こんなハンカチ持ってること{n}誰にも言わないでね？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:69",
  "hdr": "002E 000F",
  "jp": "ナスカイザーはね、ママが好きなの。{n}わたしの趣味じゃないんだから。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:70",
  "hdr": "002E 000F",
  "jp": "そうだ、これ、あげる。{n}助けてくれたお礼よ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:71",
  "hdr": "0004 000D",
  "jp": "くいーん……{n}{col_F8}(ぼくも欲しいです……)",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:72",
  "hdr": "002E 000F",
  "jp": "そうだね、帰ろうか、{var_ED}{slot}{slot}{slot}{slot}{slot}。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:73",
  "hdr": "0004 000D",
  "jp": "くいーん……{n}{col_F8}(七海さん……)",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:74",
  "hdr": "002E 000F",
  "jp": "ごめん、もう帰らなくちゃ。{n}{var_ED}{slot}{slot}{slot}{slot}{slot}、行こう。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2571:75",
  "hdr": "0004 000D",
  "jp": "わん！{n}{col_F8}(ありがとうです！)",
  "en": "",
  "status": "todo",
  "notes": ""
 }
