  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2572:7",
  "hdr": "0008 0014",
  "jp": "はいはい、紹介しますよ。{n}こっちは{var_ED}{slot}{slot}{slot}{slot}{slot}。",
