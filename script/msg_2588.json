  "hdr": "0007 000F",
  "jp": "{var_ED}{slot}{slot}{slot}{slot}{slot}が散歩に行こうって{n}うるさいの。",
  "en": "{var_ED}{slot}{slot}{slot}{slot}{slot} keeps making a fuss{n}about going for a walk.",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2588:6",
  "hdr": "0004 000D",
  "jp": "くーん……{n}{col_F8}(七海さん、ボク、静かです……)",
  "en": "Whine...{n}{col_F8}(Nanami-san, I'm being quiet...)",
  "status": "done",
  "notes": ""
 },
 {
  "id": "2588:7",
  "hdr": "0008 0014",
  "jp": "……30分。それ以上はダメよ。",
