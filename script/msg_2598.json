[
 {
  "id": "2598:0",
  "hdr": "0009 0012",
  "jp": "{var_F0}{slot}{slot}{slot}{slot}{slot}さん。{n}説明してくれますか？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:1",
  "hdr": "0009 0012",
  "jp": "七海の涙がどうこうって話の。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:2",
  "hdr": "0005 0012",
  "jp": "もちろんします。{n}でも、約束してください。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:3",
  "hdr": "0005 0012",
  "jp": "どんなにバカバカしいと{n}思っても、信じてください。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:4",
  "hdr": "0005 0012",
  "jp": "子供たちが巻き込まれているのは{n}そういう話なんです。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:5",
  "hdr": "0009 0012",
  "jp": "わかりました。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:6",
  "hdr": "0005 0012",
  "jp": "佐倉さん、あなたの先祖に{n}木吉という人がいますね。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:7",
  "hdr": "0009 0012",
  "jp": "はい。200年ほど前の人で{n}名前は佐倉木吉(ききち)。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:8",
  "hdr": "0009 0012",
  "jp": "立派な植木職人だったとか。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:9",
  "hdr": "0005 0012",
  "jp": "本当は樹医です。{n}旅から旅への木のお医者さん。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:10",
  "hdr": "0009 0012",
  "jp": "へぇ……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:11",
  "hdr": "0005 0012",
  "jp": "そして……木吉さんには{n}おたねという娘さんがいた。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:12",
  "hdr": "0009 0012",
  "jp": "いや、知らないなぁ……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:13",
  "hdr": "0005 0012",
  "jp": "いたんです！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:14",
  "hdr": "0009 0012",
  "jp": "はい。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:15",
  "hdr": "0005 0012",
  "jp": "200年前、木吉さんは{n}桐谷に桜を植えました。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:16",
  "hdr": "0005 0012",
  "jp": "咲谷町の歩奥(ぽおく)神社の桜から{n}枝をもらい受けたのです。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:17",
  "hdr": "0005 0012",
  "jp": "しかし、桜は全然育ちません。{n}今にも枯れてしまいそうです。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:18",
  "hdr": "0009 0012",
  "jp": "ああ、知ってます。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:19",
  "hdr": "0009 0012",
  "jp": "特別な方法で桜を元気に{n}したんですよね？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:20",
  "hdr": "0005 0012",
  "jp": "その通り！{n}そしてその特別な方法とは……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:21",
  "hdr": "0005 0012",
  "jp": "娘のおたねちゃんの涙を{n}桜に注ぐことだったのです！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:22",
  "hdr": "0009 0012",
  "jp": "はぁ？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:23",
  "hdr": "0005 0012",
  "jp": "桐谷町の桜にはキマヨイという{n}妖怪が取りついていました。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:24",
  "hdr": "0005 0012",
  "jp": "そのせいで、木が迷って{n}なかなか育たなかったのです。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:25",
  "hdr": "0009 0012",
  "jp": "{var_F0}{slot}{slot}{slot}{slot}{slot}さん、ダジャレですか？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:26",
  "hdr": "0005 0012",
  "jp": "妖怪の名前なんて、たいていが{n}ダジャレじゃないですか。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:27",
  "hdr": "0005 0012",
  "jp": "まあ、それはともかく。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:28",
  "hdr": "0005 0012",
  "jp": "それを知った木吉さんは{n}キマヨイに頼みました。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:29",
  "hdr": "0005 0012",
  "jp": "どうか、おとなしく静かに{n}していてくれ、と。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:30",
  "hdr": "0005 0012",
  "jp": "するとキマヨイは条件を{n}出したのです。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:31",
  "hdr": "0005 0012",
  "jp": "最愛の人を泣かせて{n}その涙を桜に注げば……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:32",
  "hdr": "0005 0012",
  "jp": "自分は200年の間だけ{n}眠ってやる、と。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:33",
  "hdr": "0005 0012",
  "jp": "200年後、おまえの子孫が{n}同じことをすれば……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:34",
  "hdr": "0005 0012",
  "jp": "次の200年も眠ってやる。{n}そういう、いわば、契約です。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:35",
  "hdr": "0009 0012",
  "jp": "どうしてキマヨイは{n}そんな約束を？　メリットは？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:36",
  "hdr": "0006 0014",
  "jp": "キノマヨイ……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:37",
  "hdr": "0005 0012",
  "jp": "その通り！{n}さすがハルカさん！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:38",
  "hdr": "0006 0014",
  "jp": "ありがと。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:39",
  "hdr": "0005 0012",
  "jp": "いいですか、佐倉さん。{n}今がその最初の200年目です。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:40",
  "hdr": "0005 0012",
  "jp": "しかも契約は春に切れていて{n}キマヨイはさまよっています。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:41",
  "hdr": "0005 0012",
  "jp": "桜からたっぷりと{n}精気を吸い取ったのでしょう。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:42",
  "hdr": "0005 0012",
  "jp": "だから桐谷の桜は枯れそうに{n}なっているんです。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:43",
  "hdr": "0005 0012",
  "jp": "そしてそれが原因で歩奥神社の{n}桜も《気》を吐きだして……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:44",
  "hdr": "0005 0012",
  "jp": "さらには眠っていた他の{n}精霊たちも妖怪となって……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
