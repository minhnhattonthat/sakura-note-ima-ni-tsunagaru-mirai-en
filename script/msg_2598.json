 },
 {
  "id": "2598:49",
  "hdr": "0005 0012",
  "jp": "子供たちが巻き込まれているのは{n}そういう事件なのです。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:50",
  "hdr": "0009 0012",
  "jp": "解決のためには、わたしが{n}七海を泣かせる？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:51",
  "hdr": "0009 0012",
  "jp": "いくら七海が泣き虫でも{n}そりゃできないな。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:52",
  "hdr": "0008 0014",
  "jp": "あの子、もう泣かないわよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:53",
  "hdr": "0008 0014",
  "jp": "わたしたちの離婚が決まった時に{n}何日も泣き続けて……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2598:54",
