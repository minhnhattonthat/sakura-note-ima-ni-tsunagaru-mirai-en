 {
  "id": "2616:4",
  "hdr": "FFFF 00FF",
  "jp": "操作説明　その5",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:5",
  "hdr": "FFFF 00FF",
  "jp": "ハイハイどうもこんにちは～！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:6",
  "hdr": "FFFF 00FF",
  "jp": "ノビヨ先生のチュートリアル講座！{n}まずは聞けっつーの！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:7",
  "hdr": "FFFF 00FF",
  "jp": "上画面を見てみなさいよ、ホレ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:8",
  "hdr": "FFFF 00FF",
  "jp": "マップが出ているではないですか。{n}僕も今初めて見たんですけど。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:9",
  "hdr": "FFFF 00FF",
  "jp": "これは少年が今いるエリアを{n}表しておるのであるのである。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:10",
  "hdr": "FFFF 00FF",
  "jp": "エリアは全部で5種類ありますぜ。{n}ほんとだっつーの。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:11",
  "hdr": "FFFF 00FF",
  "jp": "で、行く場所によって変わるワケ。{n}これもほんとだっつーの。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:12",
  "hdr": "FFFF 00FF",
  "jp": "で、さて、そこのチミ、{n}再び視線を上げて上画面に注目～！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:13",
  "hdr": "FFFF 00FF",
  "jp": "少年の顔があるのが今いる所です。{n}分かりましたね？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:14",
  "hdr": "FFFF 00FF",
  "jp": "じゃあ帰るわ……ん？{n}まだ続きがあるらしいわよ奥さん。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:15",
  "hdr": "FFFF 00FF",
  "jp": "次はこれ、まるい印であ～る！{n}ちゅーかこれこそが目的地なのだ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:16",
  "hdr": "FFFF 00FF",
  "jp": "目的地がエリア外の時もあ～る。{n}とにかく印の方に行くのであ～る。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:17",
  "hdr": "FFFF 00FF",
  "jp": "さてさて、突然ですが{n}ここで僕の新曲聴いてください。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:18",
  "hdr": "FFFF 00FF",
  "jp": "まず一曲目のナンバーです。{n}「ロコモコ丼」の歌。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:19",
  "hdr": "FFFF 00FF",
  "jp": "え？　さっさとゲーム本編を{n}プレイさせやがりまくれって？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:20",
  "hdr": "FFFF 00FF",
  "jp": "そいつはすんずれいしました。{n}せんきゅ！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:21",
  "hdr": "FFFF 00FF",
  "jp": "ノビヨのプチ講座！！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:22",
  "hdr": "FFFF 00FF",
  "jp": "だったっけ？　僕のタイトル。{n}お～い、誰か～。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:23",
  "hdr": "FFFF 00FF",
  "jp": "えー、さっきとちがう気が{n}しないでもないですが続けます。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:24",
  "hdr": "FFFF 00FF",
  "jp": "たま～に画面右下に現れる{n}アイコンの説明です。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:25",
  "hdr": "FFFF 00FF",
  "jp": "ほんとは意外としょっちゅう{n}出るんですけどね。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:26",
  "hdr": "FFFF 00FF",
  "jp": "これは新しいエピソードが{n}出現した時に表示されます。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:27",
  "hdr": "FFFF 00FF",
  "jp": "ニャンコちゃんとかワンコちゃんの{n}ちょっといい話とかウラ話とかね。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:28",
  "hdr": "FFFF 00FF",
  "jp": "何が追加されたかはYボタンで{n}エピソード選択画面を見てみて。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:29",
  "hdr": "FFFF 00FF",
  "jp": "ただし、エピソードは{n}出現しただけじゃ見られません。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:30",
  "hdr": "FFFF 00FF",
  "jp": "「ナミダ」に関係するんだけど{n}この話はまた今度ね。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:31",
  "hdr": "FFFF 00FF",
  "jp": "じゃあ作曲の仕事に戻りますよ。{n}しーゆーあげいん。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:32",
  "hdr": "FFFF 00FF",
  "jp": "やってまいりました！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:33",
  "hdr": "FFFF 00FF",
  "jp": "チュートリアル講座、ノビヨ編！{n}の、補習コーナー！！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:34",
  "hdr": "FFFF 00FF",
  "jp": "もう近ごろすっかりアレでね。{n}これを説明するの忘れてました。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:35",
  "hdr": "FFFF 00FF",
  "jp": "たまにこの画面の右下に現れる……{n}コレコレ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:36",
  "hdr": "FFFF 00FF",
  "jp": "これはね、「新しい経験」をすると{n}表示されるアイコンなのですよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:37",
  "hdr": "FFFF 00FF",
  "jp": "メニュー画面の一番右にある{n}「新しい経験」画面で確認してね。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:38",
  "hdr": "FFFF 00FF",
  "jp": "あ、ちなみに、Rボタンでも直接{n}新しい経験画面を呼び出せるよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:39",
  "hdr": "FFFF 00FF",
  "jp": "新しい経験を1ページ分そろえると{n}ごほうびでパワーアップ！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:40",
  "hdr": "FFFF 00FF",
  "jp": "要するにですね、{n}妖怪をやっつけるのに役立ちます。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:41",
  "hdr": "FFFF 00FF",
  "jp": "経験を積んで強くなるのだ！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:42",
  "hdr": "FFFF 00FF",
  "jp": "って、まるでどこかの{n}ロールプレイングみたいですね。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:43",
  "hdr": "FFFF 00FF",
  "jp": "いろんな場所でいろんな経験が{n}待ってるから、まあ頑張ってね。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:44",
  "hdr": "FFFF 00FF",
  "jp": "ところで、今日の僕の晩ご飯は{n}何かなっと……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:45",
  "hdr": "FFFF 00FF",
  "jp": "いやいやちょっと待って！{n}アレですわ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:46",
  "hdr": "FFFF 00FF",
  "jp": "ハートの事を教えてしんぜよう。{n}画面左上に出ているヤツね。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:47",
  "hdr": "FFFF 00FF",
  "jp": "「新しい経験」で増えるんだけど{n}これ、ハートなくなるとアレよ？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:48",
  "hdr": "FFFF 00FF",
  "jp": "ゲームオーバーなんだって。{n}シビアでしょ？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:49",
  "hdr": "FFFF 00FF",
  "jp": "回復ポイントもあるから探してね。{n}特に戦いには満タンで挑むのだ！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:50",
  "hdr": "FFFF 00FF",
  "jp": "よし、じゃあおじさんから{n}ひとつプレゼントしてあげよう。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:51",
  "hdr": "FFFF 00FF",
  "jp": "僕って太っ腹でしょ？{n}こんな序盤からあげちゃうから。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:52",
  "hdr": "FFFF 00FF",
  "jp": "それだけ妖怪が強いって事よ……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:53",
  "hdr": "FFFF 00FF",
  "jp": "なんてな！　ウソだって。{n}バトルなんてちょ～簡単だから。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:54",
  "hdr": "FFFF 00FF",
  "jp": "さて僕も帰ってテレビ見よっと。{n}ナスカイザーの時間だもん。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:55",
  "hdr": "FFFF 00FF",
  "jp": "ではまた「どこか」で！{n}フヒヒ……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:56",
  "hdr": "FFFF 00FF",
  "jp": "ノビヨのプチ講座最終回！{n}上から失礼～。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:57",
  "hdr": "FFFF 00FF",
  "jp": "今、ちらばったよね？{n}何かがいっぱい。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:58",
  "hdr": "FFFF 00FF",
  "jp": "それについて説明しようではないか。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:59",
  "hdr": "FFFF 00FF",
  "jp": "まるで涙のような美しい液体。{n}その名を「ナミダ」という……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:60",
  "hdr": "FFFF 00FF",
  "jp": "いくらエピソードが出現しても{n}ナミダが足りないと見られないよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:61",
  "hdr": "FFFF 00FF",
  "jp": "ナミダを集めていけば、新たな{n}エピソードもどんどん見られるよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:62",
  "hdr": "FFFF 00FF",
  "jp": "ニャンコちゃんとかワンコちゃんの{n}ちょっといい話とかウラ話がね。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:63",
  "hdr": "FFFF 00FF",
  "jp": "もっとすごいウラ話とか{n}おまけ話とか？？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:64",
  "hdr": "FFFF 00FF",
  "jp": "それは僕も知りませんねぇ。{n}僕ってホラ、作曲家じゃないすか。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:65",
  "hdr": "FFFF 00FF",
  "jp": "ま、ナミダを集めまくれって事で、{n}いっぱい仕込んであるから探してよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:66",
  "hdr": "FFFF 00FF",
  "jp": "仕込んだの僕じゃないですけどね。{n}たぶん妖怪のしわざですよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:67",
  "hdr": "FFFF 00FF",
  "jp": "あれ？　今もチミの後ろに{n}誰か見えたけど？　その人誰？",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:68",
  "hdr": "FFFF 00FF",
  "jp": "なんつって、無責任にさようなら～！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:69",
  "hdr": "FFFF 00FF",
  "jp": "ハイそこの白服の少年。{n}左に寄せてゆっくり止まりなさい。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:70",
  "hdr": "FFFF 00FF",
  "jp": "ビックリした？{n}ノビヨ先生の外国語講座です。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:71",
  "hdr": "FFFF 00FF",
  "jp": "大事な説明を忘れていました。{n}大切なボタン操作を教えましょう。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:72",
  "hdr": "FFFF 00FF",
  "jp": "Aと思えばAボタンを、{n}Bと思えばBボタンを押すのです。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:73",
  "hdr": "FFFF 00FF",
  "jp": "どうです？　カンタンでしょう？{n}さらにシンプルに説明しましょう。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:74",
  "hdr": "FFFF 00FF",
  "jp": "次のシーンに注目して下さい。{n}今あるモノを念力で呼び寄せます。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:75",
  "hdr": "FFFF 00FF",
  "jp": "さあ、来てます来てます。{n}見てなさいよ……",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:76",
  "hdr": "FFFF 00FF",
  "jp": "ジャーン！{n}まさしくこれです。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:77",
  "hdr": "FFFF 00FF",
  "jp": "これはですね、人や物に近づくと{n}こうして画面の右上に現れます。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:78",
  "hdr": "FFFF 00FF",
  "jp": "夜な夜な現れますからね。{n}ごめんなさいマジメに話します。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:79",
  "hdr": "FFFF 00FF",
  "jp": "このABアイコンには、これから{n}行うことが書かれているのじゃ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:80",
  "hdr": "FFFF 00FF",
  "jp": "少年の心の中には常に迷いがある。{n}そんな心の内を描いた作品じゃ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:81",
  "hdr": "FFFF 00FF",
  "jp": "なんか口調が変わってるよね？{n}作品ってのも大げさでした。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:82",
  "hdr": "FFFF 00FF",
  "jp": "チミの選択によって、起こる事や{n}反応も変わるのでよく考えてね。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:83",
  "hdr": "FFFF 00FF",
  "jp": "ノビヨ講座AB編でした～！",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:84",
  "hdr": "FFFF 00FF",
  "jp": "あ、ゴメン、実践編があったわ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:85",
  "hdr": "FFFF 00FF",
  "jp": "これから動いて実践してみて。{n}今僕が話したありがたい教えを。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:86",
  "hdr": "FFFF 00FF",
  "jp": "左の方にしょーもな……あ、いや{n}ハンサムボーイがいるんだよ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:87",
  "hdr": "FFFF 00FF",
  "jp": "ここからはちょっと見えないかぁ？{n}すぐ先にいるからさ、ホントに。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:88",
  "hdr": "FFFF 00FF",
  "jp": "で、さっきのアイコンが出たら{n}AボタンかBボタンを押すのだ。",
  "en": "",
  "status": "todo",
  "notes": ""
 },
 {
  "id": "2616:89",
  "hdr": "FFFF 00FF",
  "jp": "じゃ、お先～っす。",
  "en": "",
  "status": "todo",
  "notes": ""
 }
]
